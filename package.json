{
  "name": "project-frstcli",
  "version": "1.3.0",
  "description": "FranceStudent Code : agent de programmation en ligne de commande",
  "main": "index.js",
  "bin": {
    "frstcli": "index.js",
    "frst": "bin/frst.js"
  },
  "files": [
    "index.js",
    "src",
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node index.js",
    "start:tui": "npm run build:tui && node bin/frst.js",
    "build:tui": "node scripts/build-tui.js",
    "vendor:renderer": "node scripts/copy-vendor.js",
    "vendor:effectcraft": "node scripts/build-effectcraft.js",
    "build:renderer": "node scripts/copy-vendor.js && node scripts/build-renderer.js",
    "check:renderer": "node scripts/build-renderer.js --check",
    "rebuild:native": "electron-builder install-app-deps",
    "lint": "eslint .",
    "prebuild:desktop": "npm run check:effectcraft && npm run build:renderer",
    "build:desktop": "electron-builder --dir --publish never",
    "prepare": "npm run build:tui",
    "pretest": "npm run build:tui",
    "test": "node --test test/*.test.js",
    "bench:search": "node scripts/bench-search.js",
    "pretest:e2e": "npm run build:renderer",
    "test:e2e": "node --test e2e/*.e2e.test.js",
    "predesktop": "npm run build:renderer",
    "desktop": "electron desktop/main.js",
    "predist:win": "npm run check:effectcraft && npm run build:renderer",
    "predist:mac": "npm run check:effectcraft && npm run build:renderer",
    "dist:win": "electron-builder --win portable nsis --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --publish never",
    "vendor:effectcraft:upstream": "node scripts/fetch-effectcraft.js",
    "check:effectcraft": "node scripts/build-effectcraft.js --check"
  },
  "keywords": [
    "cli",
    "agent",
    "francestudent"
  ],
  "author": "Hecone",
  "license": "ISC",
  "dependencies": {
    "@kenjiuno/msgreader": "1.29.0",
    "@napi-rs/canvas": "0.1.100",
    "@xmldom/xmldom": "0.9.12",
    "7z-wasm": "1.2.0",
    "cheerio": "1.2.0",
    "dompurify": "3.4.17",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "fuse.js": "7.5.0",
    "ink": "^8.0.0",
    "ink-markdown": "^1.0.4",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "mailparser": "3.12.2",
    "marked": "9.1.6",
    "mediainfo.js": "0.3.8",
    "node-pty": "^1.1.0",
    "officeparser": "8.2.0",
    "pdfjs-dist": "5.4.624",
    "playwright-core": "^1.64.1",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "sharp": "0.35.5",
    "tar-stream": "3.1.7",
    "typescript": "^5.9.3",
    "typescript-language-server": "^4.4.1",
    "word-extractor": "1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "@napi-rs/canvas": "$@napi-rs/canvas"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "ink-testing-library": "^4.0.0",
    "lucide": "1.61.0",
    "tsx": "^4.23.15"
  },
  "build": {
    "appId": "fr.francestudent.code",
    "productName": "FranceStudent Code",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "extraopaa",
        "repo": "francestudents-ide"
      }
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "index.js",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "FranceStudentCode-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FranceStudentCode-${version}-setup.exe"
    },
    "mac": {
      "icon": "desktop/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "FranceStudentCode-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "FranceStudent Code ${version}",
      "artifactName": "FranceStudentCode-${version}-mac-${arch}.${ext}"
    }
  }
}
