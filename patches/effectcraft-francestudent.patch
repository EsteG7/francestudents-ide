+/// The introductory toolbar keeps the real tools and their command/automation identities.
+fn show_simple(app: &mut EffectcraftApp, ui: &mut egui::Ui, rect: Rect) {
+    let t = app.tokens;
+    ui.painter().rect_filled(rect, 0.0, t.header_bg);
+    let mut x = rect.min.x + 10.0;
+    for (tool, label, width) in
+        [(Tool::Selection, "Sélection", 84.0), (Tool::Hand, "Déplacer", 80.0), (Tool::Type, "Texte", 64.0), (Tool::Rectangle, "Forme", 68.0)]
+    {
+        let r = Rect::from_min_size(pos2(x, rect.center().y - 14.0), vec2(width, 28.0));
+        let response = widgets::text_button(ui, r, label, app.ui.tool == tool, &t, egui::Id::new(("frst-tool", tool)));
+        app.auto.add_response(&format!("tools.{tool:?}"), &response, label);
+        if response.clicked() {
+            if matches!(tool, Tool::Type | Tool::Rectangle) && app.session.active_comp().is_none() {
+                if let Err(error) = app.session.execute("comp.new", json!({})) {
+                    app.ui.status = error.to_string();
+                    return;
+                }
+            }
+            app.ui.tool = tool;
+        }
+        x += width + 6.0;
+    }
+    let r = Rect::from_min_size(pos2(x, rect.center().y - 14.0), vec2(82.0, 28.0));
+    let response = widgets::text_button(ui, r, "Importer", false, &t, egui::Id::new("frst-import"));
+    app.auto.add_response("file.import", &response, "Importer une image, une vidéo ou un son");
+    if response.clicked() {
+        if let Err(error) = crate::menus::invoke(app, ui.ctx(), "file.import", json!({})) {
+            app.ui.status = error;
+        }
+    }
+}
